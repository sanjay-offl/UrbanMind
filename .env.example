# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/urbanmind

# Redis connection string (agent chat memory)
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude) — used for classification and the agent
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI — used for embeddings
OPENAI_API_KEY=sk-your-key-here

# Pinecone — vector store for grievance embeddings
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=urbanmind

# Backend base URL consumed by the frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment
VERCEL_PROJECT_ID=your-vercel-project-id
RAILWAY_TOKEN=your-railway-token
