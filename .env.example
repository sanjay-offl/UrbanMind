# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/urbanmind

# Redis connection string (agent chat memory)
REDIS_URL=redis://localhost:6379/0

# Google AI / Cloud. Leave credentials blank for labelled precomputed demo mode.
GOOGLE_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=

# Backend base URL consumed by the frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment
VERCEL_PROJECT_ID=your-vercel-project-id
RAILWAY_TOKEN=your-railway-token
